# LifeLink Environment Variables
# Do NOT commit real secret keys.

# ASI:One / ASI1 LLM API Key (intent parsing and response generation)
ASI1_API_KEY=

# Optional Anthropic Claude API Key (alternative LLM provider)
ANTHROPIC_API_KEY=

# Fetch.ai Agentverse API Key (for hosted agents and registry)
AGENTVERSE_API_KEY=

# Deterministic Seed phrases for uAgents
COORDINATOR_SEED="lifelink_coordinator_agent_seed_phrase_demo_2026"
INVENTORY_SEED="lifelink_inventory_agent_seed_phrase_demo_2026"
DONOR_SEED="lifelink_donor_outreach_agent_seed_phrase_demo_2026"

# Optional Telegram Bot Token (for live donor accepts during stage demo)
TELEGRAM_BOT_TOKEN=

# Demo Location Configuration
DEMO_CITY="Jaipur, Rajasthan, India"
DEFAULT_LATITUDE=26.9124
DEFAULT_LONGITUDE=75.7873
DEFAULT_SEARCH_RADIUS_KM=15.0
EXPANDED_SEARCH_RADIUS_KM=35.0
